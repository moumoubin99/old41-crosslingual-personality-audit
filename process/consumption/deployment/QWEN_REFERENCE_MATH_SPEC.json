  "formulas": [
    {
      "id": "qwen_rms_norm",
      "name": "Root-mean-square normalization",
      "kind": "forward",
      "latex": "\\operatorname{RMSNorm}(X)=w\\odot X/\\sqrt{\\operatorname{mean}(X^2,-1)+\\epsilon}",
      "explanation": "Normalize each token over its hidden axis without mean subtraction, then apply the learned gain.",
      "expr": "norm_weight * norm_hidden / np.sqrt(np.mean(norm_hidden ** 2, axis=-1, keepdims=True) + norm_epsilon)",
      "reference_expr": "norm_weight * norm_hidden / np.sqrt(np.sum(norm_hidden ** 2, axis=-1, keepdims=True) / norm_hidden.shape[-1] + norm_epsilon)",
      "inputs": [
        "norm_hidden",
        "norm_weight",
        "norm_epsilon"
      ],
      "output": {
        "name": "normalized_hidden",
        "shape": [
          "tokens",
          "hidden"
        ]
      },
      "invariants": [
        "dim_conservation"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_rope_tables",
      "name": "Rotary half-table",
      "kind": "forward",
      "latex": "\\phi_{p,r}=p\\omega_r,\\quad C_{p,r}=\\cos(\\phi_{p,r})",
      "explanation": "Compute one half of the rotary table from absolute positions and checkpoint-derived inverse frequencies; the implementation duplicates this half to full head width.",
      "expr": "np.cos(positions[:, None] * inverse_frequency[None, :])",
      "reference_expr": "np.cos(np.einsum('t,r->tr', positions, inverse_frequency))",
      "inputs": [
        "positions",
        "inverse_frequency"
      ],
      "output": {
        "name": "rope_cos_half",
        "shape": [
          "tokens",
          "rotary"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_rope_apply",
      "name": "Rotary embedding application",
      "kind": "forward",
      "latex": "\\operatorname{RoPE}(U)=U\\odot C+R(U)\\odot S",
      "explanation": "Apply the norm-preserving half rotation with broadcast cosine and sine tables.",
      "expr": "rope_value * rope_cos + rope_rotated * rope_sin",
      "reference_expr": "rope_cos * rope_value + rope_sin * rope_rotated",
      "inputs": [
        "rope_value",
        "rope_cos",
        "rope_rotated",
        "rope_sin"
      ],
      "output": {
        "name": "rope_output",
        "shape": [
          "heads",
          "tokens",
          "head_dim"
        ]
      },
      "invariants": [
        "dim_conservation"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_linear",
      "name": "Bias-free projection",
      "kind": "forward",
      "latex": "Y=XW^{\\top}",
      "explanation": "Contract the input-feature axis against output-major checkpoint weights with no bias.",
      "expr": "np.matmul(projection_input, projection_weight.T)",
      "reference_expr": "np.einsum('ti,oi->to', projection_input, projection_weight)",
      "inputs": [
        "projection_input",
        "projection_weight"
      ],
      "output": {
        "name": "projected",
        "shape": [
          "tokens",
          "out"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_swiglu",
      "name": "SwiGLU feed-forward block",
      "kind": "forward",
      "latex": "\\operatorname{FFN}(X)=W_d(\\operatorname{SiLU}(W_gX)\\odot W_uX)",
      "explanation": "Multiply the SiLU gate and up branches elementwise, then project back to hidden width.",
      "expr": "np.matmul((np.matmul(ffn_hidden, gate_weight.T) / (1.0 + np.exp(-np.matmul(ffn_hidden, gate_weight.T)))) * np.matmul(ffn_hidden, up_weight.T), down_weight.T)",
      "reference_expr": "np.matmul(np.matmul(ffn_hidden, gate_weight.T) * (1.0 / (1.0 + np.exp(-np.matmul(ffn_hidden, gate_weight.T)))) * np.matmul(ffn_hidden, up_weight.T), down_weight.T)",
      "inputs": [
        "ffn_hidden",
        "gate_weight",
        "up_weight",
        "down_weight"
      ],
      "output": {
        "name": "ffn_output",
        "shape": [
          "tokens",
          "hidden"
        ]
      },
      "invariants": [
        "dim_conservation"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_repeat_kv",
      "name": "Grouped-query key/value repetition",
      "kind": "forward",
      "latex": "K^{rep}_{h,g,k,d}=K_{h,k,d}",
      "explanation": "Broadcast each source key/value head across a contiguous repetition-group axis; the implementation then flattens (kv_heads, groups) into query heads.",
      "expr": "np.broadcast_to(kv_input[:, None, :, :], (kv_input.shape[0], repeat_slots.shape[0], kv_input.shape[1], kv_input.shape[2]))",
      "reference_expr": "kv_input[:, None, :, :] + np.zeros((kv_input.shape[0], repeat_slots.shape[0], kv_input.shape[1], kv_input.shape[2]))",
      "inputs": [
        "kv_input",
        "repeat_slots"
      ],
      "output": {
        "name": "repeated_kv",
        "shape": [
          "kv_heads",
          "groups",
          "kv",
          "head_dim"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_causal_mask",
      "name": "Right-aligned cached causal mask",
      "kind": "forward",
      "latex": "M_{ij}=0\\;\\text{if }j\\le i+(L_{kv}-L_q),\\; -\\infty\\;\\text{otherwise}",
      "explanation": "Right-align the current query block against the cached key/value prefix.",
      "expr": "np.where(key_position[None, :] <= query_position[:, None] + key_position.shape[0] - query_position.shape[0], 0.0, -np.inf)",
      "reference_expr": "np.where(query_position[:, None] + key_position.shape[0] - query_position.shape[0] >= key_position[None, :], 0.0, -np.inf)",
      "inputs": [
        "query_position",
        "key_position"
      ],
      "output": {
        "name": "causal_mask",
        "shape": [
          "tokens",
          "kv"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_attention",
      "name": "Scaled causal attention",
      "kind": "forward",
      "latex": "\\operatorname{Attn}(Q,K,V)=\\operatorname{softmax}(QK^{\\top}/\\sqrt{d_h}+M)V",
      "explanation": "Contract queries and keys over head width, apply the additive causal mask, normalize on the key axis, and mix values.",
      "expr": "np.matmul(np.exp((np.einsum('htd,hkd->htk', query, key) / np.sqrt(query.shape[-1]) + attention_mask[None, :, :]) - np.max(np.einsum('htd,hkd->htk', query, key) / np.sqrt(query.shape[-1]) + attention_mask[None, :, :], axis=-1, keepdims=True)) / np.sum(np.exp((np.einsum('htd,hkd->htk', query, key) / np.sqrt(query.shape[-1]) + attention_mask[None, :, :]) - np.max(np.einsum('htd,hkd->htk', query, key) / np.sqrt(query.shape[-1]) + attention_mask[None, :, :], axis=-1, keepdims=True)), axis=-1, keepdims=True), value)",
      "inputs": [
        "query",
        "key",
        "value",
        "attention_mask"
      ],
      "output": {
        "name": "attention_context",
        "shape": [
          "heads",
          "tokens",
          "head_dim"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_decoder_layer",
      "name": "Pre-normalized residual decoder layer",
      "kind": "forward",
      "latex": "H'=H+A(H),\\quad H''=H'+F(H')",
      "explanation": "The captured implementation computes attention and feed-forward deltas from their own pre-normalized states; this contract isolates the exact residual addition shared by both paths.",
      "expr": "decoder_hidden + attention_delta + ffn_delta",
      "reference_expr": "(decoder_hidden + attention_delta) + ffn_delta",
      "inputs": [
        "decoder_hidden",
        "attention_delta",
        "ffn_delta"
      ],
      "output": {
        "name": "updated_hidden",
        "shape": [
          "tokens",
          "hidden"
        ]
      },
      "invariants": [
        "dim_conservation"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_model_logits",
      "name": "Language-model head",
      "kind": "forward",
      "latex": "Z=H_LW_{lm}^{\\top}",
      "explanation": "Project final normalized hidden states to vocabulary logits.",
      "expr": "np.matmul(final_hidden, lm_head.T)",
      "reference_expr": "np.einsum('th,vh->tv', final_hidden, lm_head)",
      "inputs": [
        "final_hidden",
        "lm_head"
      ],
      "output": {
        "name": "model_logits",
        "shape": [
          "tokens",
          "vocab"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_greedy",
      "name": "Greedy next-token choice",
      "kind": "inference",
      "latex": "y=\\operatorname*{argmax}_v Z_{-1,v}",
      "explanation": "Choose the first maximum vocabulary index at the last decoded position.",
      "expr": "np.argmax(logits[-1])",
      "reference_expr": "np.asarray(logits[-1]).argmax()",
      "inputs": [
        "logits"
      ],
      "output": {
        "name": "greedy_token",
        "shape": []
      },
      "invariants": [],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_temperature_softmax",
      "name": "Temperature-scaled token distribution",
      "kind": "inference",
      "latex": "\\pi_v=\\exp(z_v/T-c)/\\sum_u\\exp(z_u/T-c)",
      "explanation": "Stably normalize the last-position logits at the registered positive temperature.",
      "expr": "np.exp(logits[-1] / temperature - np.max(logits[-1] / temperature)) / np.sum(np.exp(logits[-1] / temperature - np.max(logits[-1] / temperature)))",
      "reference_expr": "np.exp((logits[-1] - np.max(logits[-1])) / temperature) / np.sum(np.exp((logits[-1] - np.max(logits[-1])) / temperature))",
      "inputs": [
        "logits",
        "temperature"
      ],
      "output": {
        "name": "token_probability",
        "shape": [
          "vocab"
        ]
      },
      "invariants": [
        "prob_sum_to_1"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_nucleus",
      "name": "Nucleus renormalization",
      "kind": "inference",
      "latex": "\\tilde\\pi_v=m_v\\exp(z_v)/\\sum_um_u\\exp(z_u)",
      "explanation": "Renormalize the implementation-computed top-p keep mask. The independent sampler contract verifies the descending cumulative-mass construction, boundary token retention and empirical draws at top_p=0.95.",
      "expr": "(np.where(nucleus_mask > 0.0, np.exp(nucleus_logits - np.max(nucleus_logits, axis=-1, keepdims=True)), 0.0) + 1e-12) / np.sum(np.where(nucleus_mask > 0.0, np.exp(nucleus_logits - np.max(nucleus_logits, axis=-1, keepdims=True)), 0.0) + 1e-12, axis=-1, keepdims=True)",
      "reference_expr": "(np.exp(nucleus_logits - np.max(nucleus_logits, axis=-1, keepdims=True)) * (nucleus_mask > 0.0) + 1e-12) / np.sum(np.exp(nucleus_logits - np.max(nucleus_logits, axis=-1, keepdims=True)) * (nucleus_mask > 0.0) + 1e-12, axis=-1, keepdims=True)",
      "inputs": [
        "nucleus_logits",
        "nucleus_mask"
      ],
      "output": {
        "name": "nucleus_probability",
        "shape": [
          "batch",
          "vocab"
        ]
      },
      "invariants": [
        "prob_sum_to_1"
      ],
      "status": "deployment-standard"
    },
    {
      "id": "qwen_generate",
      "name": "Autoregressive cache-length recurrence",
      "kind": "inference",
      "latex": "L_{t+1}=L_t+1",
      "explanation": "Each sampled token extends the attended prefix by exactly one; sampler choice and EOS stopping are separately exercised by the generation contract.",
      "expr": "sequence_length + 1",
      "reference_expr": "1 + sequence_length",
      "inputs": [
        "sequence_length"
      ],
      "output": {
        "name": "next_sequence_length",
        "shape": [
          "steps"
        ]
      },
      "invariants": [],
      "status": "deployment-standard"
    }
  ],
